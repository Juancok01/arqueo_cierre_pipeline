# Session pooler de Supabase (el mismo host que en DBeaver, puerto 5432).
# La contraseña va tal cual. Si tiene @ # o espacios, codifícala solo aquí, en la URL.
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# Cuántos días hacia atrás revisa cada corrida. El registro local evita correos duplicados.
DIAS_ATRAS=2

# false imprime el correo y no lo envía. Pásalo a true solo cuando SMTP esté listo.
ENVIAR_CORREO=false

# Mientras tenga un correo, el aviso llega aquí y no al cliente. Déjalo vacío para enviar al dueño.
CORREO_PRUEBA=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=clave_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
